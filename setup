#!/usr/bin/env bash
# review-loop setup — the WRAPPER. It finds node and execs lib/setup.mjs.
#
# WHY BASH, AND WHY NOT `#!/usr/bin/env node`. Measured on the machine this was
# written on: node comes from nvm (~/.nvm/versions/node/v24.9.0/bin/node), is
# MISSING under a bare PATH, and `claude` is a native binary that does not put
# node on PATH. A shebang failure would print `env: node: No such file or
# directory` — no `setup:` prefix, no instructions — which is exactly the
# silence-that-looks-like-breakage this project exists to prevent.
#
# WHAT THIS DOES NOT ELIMINATE, said out loud: this file is still bash, and still
# carries `CDPATH= cd -- "$(dirname "$0")" && pwd -P`. That construct is where the
# release's highest-severity defect lived. The bash surface drops from 486 lines
# to ~60; it does not reach zero, and the residue is the defect-dense part.
set -u

# Exit codes are shared with lib/setup.mjs and are load-bearing:
#   1 we lost control (set -u death, uncaught throw) — reserved, never reused
#   2 refusal   3 lock held   4 unparseable settings   5 write failed
#   6 node missing, too old, or unrunnable
NODE_FLOOR=18

# TWO DIFFERENT THINGS, and conflating them broke a test on the first run:
#   SELF_DIR            where lib/setup.mjs lives (this wrapper's own tree)
#   REVIEW_LOOP_SRC     where hooks/ lives (what gets INSTALLED, caller's choice)
# A test points REVIEW_LOOP_SRC at a tree with no shim to prove setup refuses;
# resolving lib/ from there failed with the wrong message instead. One variable
# doing two jobs is the shape every defect in rounds 9-13 had.
SELF_DIR=$(CDPATH= cd -- "$(dirname "$0")" && pwd -P)

# REVIEW_LOOP_SETUP_LIB is the MUTATION SWAP POINT for the implementation. Without
# it, a mutated copy of this wrapper would exec the UNMUTATED lib (every mutant
# survives for reasons unrelated to coverage) or find no lib/ at all (every mutant
# reports a FALSE KILLED — worse, because it reads as better news than the truth).
LIB=${REVIEW_LOOP_SETUP_LIB:-}
if [ -z "$LIB" ]; then
  # SELF_DIR ONLY. Falling back to REVIEW_LOOP_SRC put that variable back to doing
  # the lib-lookup job the comment above says it does not do — and a test that
  # points it at a shim-less stub tree then made an UNMUTATED copy of this wrapper
  # fail, i.e. a false KILLED, which this file's own header calls worse than a
  # false SURVIVED. A copy that lives outside the repo must set
  # REVIEW_LOOP_SETUP_LIB; there is nothing else it could correctly guess.
  [ -f "$SELF_DIR/lib/setup.mjs" ] && LIB=$SELF_DIR/lib/setup.mjs
fi
[ -n "$LIB" ] && [ -f "$LIB" ] || {
  echo "setup: cannot find lib/setup.mjs beside $SELF_DIR" >&2
  echo "setup: if this is a copy of the script, set REVIEW_LOOP_SETUP_LIB." >&2
  exit 2
}

# NODE_OPTIONS is scrubbed: `NODE_OPTIONS=--inspect` prints "Debugger listening
# on…" to stderr on every run, unprefixed. Same bare-stderr class the messages
# below exist to close.
unset NODE_OPTIONS

find_node() {
  command -v node 2>/dev/null && return 0
  for _c in \
    "${NVM_DIR:-${HOME:-}/.nvm}/alias/default" \
    ; do
    [ -r "$_c" ] || continue
    _v=$(cat "$_c" 2>/dev/null) || continue
    for _p in "${NVM_DIR:-${HOME:-}/.nvm}/versions/node/$_v/bin/node" \
              "${NVM_DIR:-${HOME:-}/.nvm}/versions/node/v$_v/bin/node"; do
      [ -x "$_p" ] && { printf '%s\n' "$_p"; return 0; }
    done
  done
  for _p in \
    /opt/homebrew/bin/node \
    /usr/local/bin/node \
    "${HOME:-}/.volta/bin/node" \
    "${HOME:-}/.local/share/fnm/aliases/default/bin/node" \
    "${HOME:-}/Library/Application Support/fnm/aliases/default/bin/node" \
    /usr/bin/node
  do
    [ -x "$_p" ] && { printf '%s\n' "$_p"; return 0; }
  done
  return 1
}

NODE=$(find_node) || {
  echo "setup: node is required and was not found." >&2
  echo "setup: install Node $NODE_FLOOR or newer, or put node on PATH, and re-run." >&2
  echo "setup: nothing was changed." >&2
  exit 6
}

# "FOUND" IS NOT "RUNNABLE", and the gap is a fresh bare-stderr path: a node that
# resolves but cannot load its libraries prints a bare `dyld[...]: Library not
# loaded:` and nothing else. So the probe runs the RESOLVED binary (this machine
# has two nodes; a bare `node` would validate a different one), redirects its
# stderr, and reports the failure itself.
#
# The floor is checked BY NODE, not by comparing version strings in bash:
# `[ "$(node -v)" \< "v18" ]` is lexical and ranks v9.11.2 above v18.0.0, and
# `sort -V` would mean another dependency. This form also proves the binary RUNS.
if ! "$NODE" -e 'process.exit(+process.versions.node.split(".")[0] >= '"$NODE_FLOOR"' ? 0 : 1)' 2>/dev/null; then
  echo "setup: $NODE cannot run this, or is older than Node $NODE_FLOOR." >&2
  echo "setup: upgrade Node and re-run. Nothing was changed." >&2
  exit 6
fi

# REVIEW_LOOP_SRC passes through UNCHANGED — it is the caller's statement about
# which tree to install FROM, not about where this wrapper lives.
exec "$NODE" "$LIB" "$@"
